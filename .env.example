TZ=Asia/Shanghai
MD_WORKSPACE_PORT=23333

# Leave HISTORY_BACKEND empty to use browser localStorage.
# Supported values: redis, mysql
HISTORY_BACKEND=

# Redis settings
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
HISTORY_REDIS_PREFIX=md-workspace:history

# MySQL settings
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=markdown_workspace
HISTORY_MYSQL_TABLE=markdown_history
